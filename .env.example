# Copy non-secret settings into the ai-stack Komodo environment.
VAST_SSH_HOST=gpu.example.invalid
VAST_SSH_PORT=2222
VAST_SSH_USER=root
AI_GATEWAY_PORT=11435
NGINX_IMAGE=nginx:1.30.8-alpine
ALPINE_IMAGE=alpine:3.24.4
# Supply these through Komodo's secret variables. Empty values fail at startup.
# Base64 is transport encoding, not encryption; treat this value as a private key.
VAST_SSH_PRIVATE_KEY_B64=
VAST_SSH_KNOWN_HOSTS=
TPE_AI_API_KEY=
